# Copy this file to `.env` (which is git-ignored) and fill in your own values.
# Values come from the Supabase dashboard: Project Settings → API.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Google sign-in (#84) — OAuth 2.0 client IDs from Google Cloud Console.
# GOOGLE_WEB_CLIENT_ID (the "Web" client) is required on every platform —
# Supabase validates the ID token's audience against it. GOOGLE_IOS_CLIENT_ID
# is required in addition on iOS only.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
